# Toolchain is downloaded by tools/install.sh, never committed (~1 GB).
toolchain/

# Simulation and synthesis products.
*.vvp
*.vcd
*.fst
*.config
*.bit
*.dot
*.svg
*.out

# yosys netlists are .json; the "!" rules below keep real source .json files.
# NB: gitignore only treats '#' as a comment at the START of a line, so never
# put an explanatory comment after a pattern — it silently becomes part of it.
*.json
!**/icestudio/*.json
!**/diagrams/*.wave.json
!icestudio/collections/**/*.json
!.vscode/*.json
!docs/*.json

# Diagrams are committed even when generated: a reader on GitHub, or anyone
# who has not run tools/mkwave.sh, still needs to see the pictures.
!docs/diagrams/*.svg
!**/diagrams/*.svg

# Generated docs.
docs/book/
docs/src/lessons/

# Print-ready copies of the diagrams, generated by tools/svg-flatten.py from
# the theme-aware originals in docs/diagrams/ and each lesson's diagrams/.
# The book.pdf itself IS committed: it is the deliverable, and a reader should
# not need a typesetter installed to read it.
docs/pdf/figures/

# SymbiYosys working directories. sby creates one per .sby file and task,
# holding the solver model, logs and any counterexample traces.
14-formal/alu_prove/
14-formal/alu_cover/
14-formal/regfile_prove/
14-formal/regfile_cover/
14-formal/broken/
14-formal/vacuous_prove/
14-formal/vacuous_cover/

# Icestudio / apio build output. Icestudio writes ice-build/ next to the .ice
# file when you press Build; it contains a generated main.v, main.lpf and
# apio.ini, none of which are source.
**/_build/
**/ice-build/
.icestudio/

# RISC-V software build output (lesson 13+).
*.elf
*.bin
*.map
*.o

# .hex files are usually objcopy output, but a hand-written or generated one
# that a design reads with $readmemh is SOURCE -- lesson 08's font, lesson 13's
# test program. Ignore built ones, keep the ones that live beside a lesson.
*.hex
!0[0-9]-*/*.hex
!1[0-7]-*/*.hex

.DS_Store
