# Prove the register file over every sequence of 12 operations.
#
# Unlike the ALU, this design has state, so depth matters: this proves the
# properties hold for every 12-step sequence of reads and writes, over every
# address and every data value.

[tasks]
prove
cover

[options]
prove: mode bmc
prove: depth 12
cover: mode cover
cover: depth 12
expect pass

[engines]
smtbmc z3

[script]
read -formal regfile.v
read -formal regfile_props.v
prep -top regfile_props

[files]
../11-regfile/regfile.v
regfile_props.v
